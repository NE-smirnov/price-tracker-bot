#!/usr/bin/env bash
#
# pre-push: run the test suite before anything leaves the machine.
#
# Bypass: git push --no-verify   or   HOOK_SKIP_TESTS=1 git push
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
PATH="$REPO_ROOT/.tools:$PATH"
# Hooks launched from a GUI git client inherit a minimal PATH that usually lacks
# the Go toolchain, which would fail the hook for a reason unrelated to the code.
for candidate in /usr/local/go/bin "$HOME/go/bin" /opt/homebrew/bin /usr/local/bin; do
  case ":$PATH:" in
    *":$candidate:"*) ;;
    *) [ -d "$candidate" ] && PATH="$PATH:$candidate" ;;
  esac
done
export PATH

if ! command -v go >/dev/null 2>&1; then
  echo "hook: go not found in PATH; install Go or add it to PATH" >&2
  exit 1
fi

if [ "${HOOK_SKIP_TESTS:-0}" = "1" ]; then
  echo "pre-push: tests skipped (HOOK_SKIP_TESTS=1)"
  exit 0
fi

echo "==> go test -race ./..."
if ! go test -race -count=1 ./...; then
  cat >&2 <<'EOF'

pre-push rejected: tests are failing.
Fix them, or push with --no-verify if you know what you are doing.
EOF
  exit 1
fi
echo "pre-push passed"
