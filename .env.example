# Copy to .env and fill in. .env is git-ignored.

# ------------------------------------------------------------------ common
APP_ENV=local           # local | dev | prod
LOG_LEVEL=debug         # debug | info | warn | error
LOG_FORMAT=text         # text | json

# ------------------------------------------------------------------ telegram bot
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated telegram user ids allowed to use the bot. Empty = everyone.
TELEGRAM_ALLOWED_USERS=
# Bot storage backend: memory (self-contained) | core (gRPC to the core service)
BOT_STORAGE=memory
# gRPC address of the core service (used when BOT_STORAGE=core)
CORE_GRPC_ADDR=localhost:9090

# ------------------------------------------------------------------ core service
CORE_GRPC_LISTEN=:9090
# How long a computed /stats answer stays cached in Redis
CORE_STATS_TTL=5m

# ------------------------------------------------------------------ postgres
POSTGRES_DSN=postgres://price:price@localhost:5432/price_tracker?sslmode=disable
POSTGRES_MAX_CONNS=10
# Scratch database for `make test-integration`. Tests that need it are skipped
# when this is empty, so `make test` works with no infrastructure at all.
TEST_DATABASE_URL=postgres://price:price@localhost:5432/price_tracker_test?sslmode=disable

# ------------------------------------------------------------------ redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------ scraper
SCRAPER_WORKERS=8
SCRAPER_HTTP_TIMEOUT=15s
SCRAPER_PER_HOST_RPS=1
SCRAPER_USER_AGENT=price-tracker-bot/0.1 (+https://github.com/NE-smirnov/price-tracker-bot)

# ------------------------------------------------------------------ currency
# frankfurter.app needs no API key; exchangerate.host does
CURRENCY_PROVIDER=frankfurter
CURRENCY_API_BASE=https://api.frankfurter.app
CURRENCY_API_KEY=
CURRENCY_CACHE_TTL=1h
