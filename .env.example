# Copy to .env and fill in. .env is git-ignored.

# ------------------------------------------------------------------ common
APP_ENV=local           # local | dev | prod
LOG_LEVEL=debug         # debug | info | warn | error
LOG_FORMAT=text         # text | json

# ------------------------------------------------------------------ telegram bot
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated telegram user ids allowed to use the bot. Empty = everyone.
TELEGRAM_ALLOWED_USERS=
# Bot storage backend: memory (self-contained) | core (gRPC to the core service)
BOT_STORAGE=memory
# gRPC address of the core service (used when BOT_STORAGE=core)
CORE_GRPC_ADDR=localhost:9090

# ------------------------------------------------------------------ core service
CORE_GRPC_LISTEN=:9090
# How long a computed /stats answer stays cached in Redis
CORE_STATS_TTL=5m

# ------------------------------------------------------------------ postgres
POSTGRES_DSN=postgres://price:price@localhost:5432/price_tracker?sslmode=disable
POSTGRES_MAX_CONNS=10
# Scratch database for `make test-integration`. Tests that need it are skipped
# when this is empty, so `make test` works with no infrastructure at all.
TEST_DATABASE_URL=postgres://price:price@localhost:5432/price_tracker_test?sslmode=disable

# ------------------------------------------------------------------ redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------ scraper
# Concurrent scrapes. Politeness is enforced per shop separately, so this only
# bounds resource use.
SCRAPER_WORKERS=4
# Items claimed from core per round. Must be >= SCRAPER_WORKERS.
SCRAPER_BATCH_SIZE=16
# Minimum delay between two requests to the same shop. The single most important
# setting for not getting blocked; lower it only for shops you own.
SCRAPER_PER_HOST_GAP=3s
SCRAPER_REQUEST_TIMEOUT=20s
SCRAPER_MAX_RETRIES=2
# How long a claimed item stays hidden from other workers.
SCRAPER_LEASE=2m
# Pause after finding nothing due, so an idle deployment does not poll in a loop.
SCRAPER_IDLE_PAUSE=15s
# Empty uses the built-in browser-like agent, which is what most shops require.
SCRAPER_USER_AGENT=
CURRENCY_GRPC_ADDR=localhost:9091

# ------------------------------------------------------------------ currency
CURRENCY_GRPC_LISTEN=:9091
# Keyless provider. Empty uses open.er-api.com, the default: unlike Frankfurter
# (ECB data) it publishes RUB, which the supported shops quote in.
CURRENCY_PROVIDER_URL=
# How long one fetched rate table is reused. Rates are published daily, so an
# hour is already far more often than the data changes.
CURRENCY_RATE_TTL=1h
CURRENCY_PROVIDER_TIMEOUT=10s

# ------------------------------------------------------------------ notifier
# Concurrent sends. Telegram allows roughly 30 messages/second overall.
NOTIFIER_WORKERS=2
# Delay before a throttled or failed alert is retried.
NOTIFIER_REQUEUE_DELAY=10s
# Attempts before an undeliverable alert is dropped.
NOTIFIER_MAX_ATTEMPTS=5
